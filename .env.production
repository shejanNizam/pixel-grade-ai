# Loaded automatically by `next build` (production). These NEXT_PUBLIC_* values
# are INLINED into the client bundle at BUILD time — you must rebuild and
# redeploy after changing them. No trailing slash on the API URL (the code
# appends `/api/v1`, so a trailing slash would produce a double slash).
NEXT_PUBLIC_API_URL=https://nizamshejan5000.merinasib.shop
NEXT_PUBLIC_IMAGE_URL=https://nizamshejan5000.merinasib.shop
# The frontend's OWN public URL (used for canonical links, sitemap, OG tags).
# Change this to your deployed frontend domain if it differs from the API.
NEXT_PUBLIC_SITE_URL=https://nizamshejan5000.merinasib.shop
