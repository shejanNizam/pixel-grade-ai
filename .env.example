# -----------------------------------------------------------------------------
# Frontend environment variables.
#
# All are NEXT_PUBLIC_* and are INLINED into the client bundle at BUILD time.
# Changing them requires a rebuild + redeploy — they are NOT read at runtime.
#
# File strategy (Next.js loads these automatically):
#   .env.development   -> used by `next dev`   (local backend)
#   .env.production    -> used by `next build` (production backend)
#   .env.local         -> DO NOT USE for URLs: it overrides BOTH of the above,
#                         including production builds. Reserve it for a personal
#                         machine-only secret, never for the API URL.
#
# The API URL must have NO trailing slash — the code appends `/api/v1`.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-backend.example.com
NEXT_PUBLIC_IMAGE_URL=https://your-backend.example.com
# The frontend's own public URL (canonical links, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://your-frontend.example.com
