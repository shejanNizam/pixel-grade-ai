# -----------------------------------------------------------------------------
# Frontend environment variables — PixelGrade AI
#
# All variables start with NEXT_PUBLIC_* and are inlined at build time.
# Changing these requires rebuilding the Next.js frontend application.
# -----------------------------------------------------------------------------

# Backend Express REST API URL (No trailing slash — app appends /api/v1)
NEXT_PUBLIC_API_URL=https://api.pixelgradeai.com

# Backend static file / media base URL
NEXT_PUBLIC_IMAGE_URL=https://api.pixelgradeai.com

# Frontend public canonical URL (SEO, sitemap, OG tags, share links)
NEXT_PUBLIC_SITE_URL=https://pixelgradeai.com

# Google OAuth Client ID for frontend Google Sign-In (optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Stripe Publishable Key for frontend checkout/payments (optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# test