# Copy this file to `.env.local` and fill in your values.

# Base URL of your backend API (required for the RTK Query data layer).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL that uploaded images/files are served from (often the same host).
NEXT_PUBLIC_IMAGE_URL=http://localhost:8000

# Absolute URL of the deployed site — used for SEO metadata, sitemap & robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client id — only needed if you wire up Google Sign-In.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
